{
  "name": "Stationly Staff",
  "short_name": "Staff",
  "description": "Clock in, see your shift, message your manager.",
  "id": "/staff/?source=pwa",
  "start_url": "/staff/?source=pwa",
  "scope": "/staff/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "theme_color": "#e8a33d",
  "background_color": "#faf5ea",
  "lang": "en-US",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Clock in", "short_name": "Clock", "url": "/staff/?view=clock", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Messages", "short_name": "Messages", "url": "/staff/?view=messages", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
}
